{
  // Config is read from .env in the working directory (config.Load), so every
  // entry runs from the repo root. Copy .env.example to .env first.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingestor",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/ingestor",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingestor (skip match details)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/ingestor",
      "cwd": "${workspaceFolder}",
      "env": { "INGEST_DETAILS_PER_RUN": "0" }
    },
    {
      "name": "Create user (type the password in the terminal)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/useradd",
      "cwd": "${workspaceFolder}",
      "args": ["-email", "${input:email}", "-name", "${input:name}"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API server + Ingestor",
      "configurations": ["API server", "Ingestor"],
      "stopAll": true
    }
  ],
  "inputs": [
    { "id": "email", "type": "promptString", "description": "Email" },
    { "id": "name", "type": "promptString", "description": "Display name" }
  ]
}
