# Copy to deploy/.env (never commit it): cp .env.example .env && chmod 600 .env

DOMAIN=api.example.com
# Shown in traces/metrics as service.version; e.g. VERSION=$(git describe --tags --always)
VERSION=dev

POSTGRES_USER=newsscore
# URL-safe only: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=newsscore

# Comma-separated; generate with: openssl rand -hex 32
API_KEYS=
RATE_LIMIT_REQUESTS_PER_MINUTE=600
OTEL_TRACE_SAMPLE_RATE=0.1

# Grafana Cloud > your stack > Connections > OpenTelemetry (OTLP).
# Endpoint looks like https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=

# Frontend origin(s) allowed to use the session cookie, comma-separated.
CORS_ALLOWED_ORIGINS=https://example.com
