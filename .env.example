APP_SERVICE_NAME=newsscore
APP_PORT=8080
# development | staging | production
APP_ENV=development
APP_READ_HEADER_TIMEOUT=5s
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s
# Time /ready reports 503 before the server stops. Set above the LB/probe period in prod.
APP_SHUTDOWN_DRAIN_DELAY=0s
# Max time for in-flight requests + telemetry flush. Keep drain + timeout below the orchestrator grace period.
APP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=DEBUG

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=newsscore
# production requires require | verify-ca | verify-full
DB_SSL_MODE=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
# How long startup keeps retrying the first DB connection.
DB_CONNECT_TIMEOUT=30s
# Server-side per-query limit; must be below APP_WRITE_TIMEOUT.
DB_STATEMENT_TIMEOUT=5s

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Defaults to true only in development. Set true elsewhere only for a collector on the same private network.
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATE=1.0

# Comma-separated keys for X-API-Key on write endpoints. Required outside development.
API_KEYS=
RATE_LIMIT_REQUESTS_PER_MINUTE=600
# Comma-separated CIDRs of reverse proxies/LBs in front of the app. Empty = use TCP peer IP.
# Set this behind a load balancer, otherwise all clients share the proxy's rate-limit bucket.
TRUSTED_PROXIES=
